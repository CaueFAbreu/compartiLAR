@startuml modelo-conceitual
!pragma layout elk
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam entityBorderColor #333333
skinparam entityBackgroundColor #FFFFFF
skinparam arrowColor #333333

title compartiLAR - Modelo Conceitual (Diagrama Entidade-Relacionamento)

entity "USUARIO" as Usuario {
  * id : identificador
  --
  * nome : texto
  * email : texto <<único>>
  * senha_hash : texto
  * telefone : texto
  foto_url : texto
  * papel : {ESTUDANTE, PROPRIETARIO, MODERADOR}
  * status : {PENDENTE, ATIVO, SUSPENSO}
  suspenso_ate : data
  * criado_em : data e hora
}

entity "ESTUDANTE" as Estudante {
  * usuario_id : FK
  --
  * curso_id : FK
  * periodo : inteiro
  apresentacao : texto
}

entity "PROPRIETARIO" as Proprietario {
  * usuario_id : FK
  --
  * cpf : texto <<único>>
  * verificacao : {AGUARDANDO, APROVADO, RECUSADO}
  verificado_por : FK
  motivo_recusa : texto
}

entity "PERFIL_CONVIVENCIA" as Perfil {
  * estudante_id : FK
  --
  * horario_sono : {CEDO, TARDE, VARIAVEL}
  * organizacao : inteiro (1 a 5)
  * festas_visitas : {NUNCA, AS_VEZES, FREQUENTE}
  * fumante : booleano
  * tem_pet : booleano
  * aceita_pet : booleano
  * silencio_estudo : inteiro (1 a 5)
  * visitas_pernoite : booleano
  * local_estudo : {CASA, BIBLIOTECA, AMBOS}
  * divisao_tarefas : {ESCALA, CADA_UM, DIARISTA}
  * permanencia : {SEMESTRE, ANO, CURSO}
}

entity "CODIGO_VERIFICACAO" as Codigo {
  * id : identificador
  --
  * usuario_id : FK
  * tipo : {CONFIRMACAO, REDEFINICAO_SENHA}
  * codigo_hash : texto
  * tentativas : inteiro
  * expira_em : data e hora
}

entity "CAMPUS" as Campus {
  * id : identificador
  --
  * nome : texto
  * latitude : decimal
  * longitude : decimal
}

entity "CURSO" as Curso {
  * id : identificador
  --
  * nome : texto
  * campus_id : FK
}

entity "MORADIA" as Moradia {
  * id : identificador
  --
  * anunciante_id : FK
  * tipo : {REPUBLICA, APARTAMENTO, CASA, KITNET, QUARTO}
  * modalidade : {VAGAS, IMOVEL_INTEIRO}
  * titulo : texto
  * descricao : texto
  * logradouro, numero, bairro, cep : texto
  complemento : texto
  * latitude : decimal
  * longitude : decimal
  * publico : {MASCULINO, FEMININO, MISTO}
  * aceita_pet : booleano
  * permite_fumar : booleano
  * permite_visitas : booleano
  * num_moradores : inteiro
  divisao_despesas : texto
  mobilia_inclusa : texto
  * status : {AGUARDANDO, ATIVA, PAUSADA, OCULTA, REMOVIDA}
  * criado_em : data e hora
}

entity "DISTANCIA_CAMPUS" as Distancia {
  * moradia_id : FK
  * campus_id : FK
  --
  * distancia_metros : inteiro
}

entity "COMODIDADE" as Comodidade {
  * id : identificador
  --
  * nome : texto <<único>>
}

entity "MORADIA_COMODIDADE" as MoradiaComodidade {
  * moradia_id : FK
  * comodidade_id : FK
}

entity "FOTO_MORADIA" as Foto {
  * id : identificador
  --
  * moradia_id : FK
  * url : texto
  * ordem : inteiro
  comodo : texto
}

entity "VAGA" as Vaga {
  * id : identificador
  --
  * moradia_id : FK
  * tipo_quarto : {INDIVIDUAL, COMPARTILHADO}
  * valor_aluguel : decimal
  * valor_contas : decimal
  valor_condominio : decimal
  * disponivel_em : data
  * status : {DISPONIVEL, OCUPADA}
}

entity "MORADOR" as Morador {
  * moradia_id : FK
  * estudante_id : FK
  --
  * status : {CONVIDADO, CONFIRMADO, SAIU}
  * desde : data
}

entity "INTERESSE" as Interesse {
  * id : identificador
  --
  * estudante_id : FK
  * vaga_id : FK
  * mensagem : texto
  * status : {PENDENTE, ACEITO, RECUSADO, CANCELADO}
  * criado_em : data e hora
  respondido_em : data e hora
}

entity "VISITA" as Visita {
  * id : identificador
  --
  * interesse_id : FK
  * data_hora : data e hora
  * status : {PROPOSTA, CONFIRMADA, CANCELADA}
}

entity "PROCURA_COLEGA" as Procura {
  * id : identificador
  --
  * estudante_id : FK
  * campus_id : FK
  * orcamento_max : decimal
  * tipo_desejado : {REPUBLICA, APARTAMENTO, CASA, KITNET, QUARTO}
  * data_mudanca : data
  descricao : texto
  * ativa : booleano
}

entity "CONVITE_COLEGA" as Convite {
  * id : identificador
  --
  * remetente_id : FK
  * procura_id : FK
  * mensagem : texto
  * status : {PENDENTE, ACEITO, RECUSADO}
  * criado_em : data e hora
}

entity "AVALIACAO" as Avaliacao {
  * id : identificador
  --
  * estudante_id : FK
  * moradia_id : FK
  * nota_custo_beneficio : inteiro (1 a 5)
  * nota_localizacao : inteiro (1 a 5)
  * nota_conservacao : inteiro (1 a 5)
  * nota_convivencia : inteiro (1 a 5)
  comentario : texto
  resposta_anunciante : texto
  * criado_em : data e hora
}

entity "FAVORITO" as Favorito {
  * estudante_id : FK
  * moradia_id : FK
  --
  * criado_em : data e hora
}

entity "DENUNCIA" as Denuncia {
  * id : identificador
  --
  * denunciante_id : FK
  * moradia_id : FK
  moderador_id : FK
  * motivo : {GOLPE, ANUNCIO_FALSO, DISCRIMINACAO, INADEQUADO, OUTRO}
  descricao : texto
  * status : {PENDENTE, PROCEDENTE, IMPROCEDENTE}
  justificativa : texto
  * criado_em : data e hora
  resolvida_em : data e hora
}

' Usuários e especializações
Usuario ||--o| Estudante : "é um"
Usuario ||--o| Proprietario : "é um"
Usuario |o--o{ Proprietario : "verifica (moderador)"
Usuario ||--o{ Codigo : recebe
Estudante ||--o| Perfil : possui
Curso ||--o{ Estudante : matricula
Campus ||--o{ Curso : sedia

' Moradias
Usuario ||--o{ Moradia : anuncia
Moradia ||--|{ Foto : possui
Moradia ||--|{ Vaga : oferece
Moradia ||--o{ MoradiaComodidade : tem
Comodidade ||--o{ MoradiaComodidade : "está em"
Moradia ||--o{ Distancia : "fica a"
Campus ||--o{ Distancia : "dista de"
Moradia ||--o{ Morador : abriga
Estudante ||--o{ Morador : "mora em"

' Contato
Estudante ||--o{ Interesse : demonstra
Vaga ||--o{ Interesse : recebe
Interesse ||--o{ Visita : agenda

' Convivência
Estudante ||--o{ Procura : publica
Campus ||--o{ Procura : referencia
Procura ||--o{ Convite : recebe
Estudante ||--o{ Convite : envia
Estudante ||--o{ Favorito : favorita
Moradia ||--o{ Favorito : "é favoritada"

' Confiança
Estudante ||--o{ Avaliacao : faz
Moradia ||--o{ Avaliacao : recebe
Usuario ||--o{ Denuncia : registra
Usuario |o--o{ Denuncia : "analisa (moderador)"
Moradia ||--o{ Denuncia : "é alvo de"
@enduml
